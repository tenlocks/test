{
  "name": "geolibre-toolbox-standalone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GeoLibre WhiteboxTools toolbox UI, cut out of the GeoLibre monorepo (no map / SQL / Cesium / Tauri).",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 5173",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node scripts/e2e.mjs",
    "e2e:vector": "node scripts/e2e-vector.mjs"
  },
  "dependencies": {
    "@geolibre/core": "*",
    "@geolibre/processing": "*",
    "@geolibre/ui": "*",
    "@turf/bbox": "^7.4.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "geotiff": "^3.0.5",
    "playwright": "1.56.1"
  },
  "overrides": {
    "geolibre-wasm": "1.5.9"
  },
  "engines": {
    "node": ">=20"
  }
}
