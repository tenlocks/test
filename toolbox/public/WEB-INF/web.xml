<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
  <!-- Vite emits content-hashed file names under assets/, so they can be cached "forever".
       index.html must stay revalidated so a new deploy is picked up. -->
  <filter>
    <filter-name>ExpiresFilter</filter-name>
    <filter-class>org.apache.catalina.filters.ExpiresFilter</filter-class>
    <init-param><param-name>ExpiresByType application/wasm</param-name><param-value>access plus 1 year</param-value></init-param>
    <init-param><param-name>ExpiresByType text/javascript</param-name><param-value>access plus 1 year</param-value></init-param>
    <init-param><param-name>ExpiresByType application/javascript</param-name><param-value>access plus 1 year</param-value></init-param>
    <init-param><param-name>ExpiresByType text/css</param-name><param-value>access plus 1 year</param-value></init-param>
    <init-param><param-name>ExpiresByType text/html</param-name><param-value>access plus 0 seconds</param-value></init-param>
  </filter>
  <filter-mapping><filter-name>ExpiresFilter</filter-name><url-pattern>/*</url-pattern><dispatcher>REQUEST</dispatcher></filter-mapping>
</web-app>
